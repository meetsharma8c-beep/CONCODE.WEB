# ═══════════════════════════════════════════════════════════════
# CONCODE Platform — Production Environment Template
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env and fill in all REQUIRED values before launch.
# Generate secrets with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

NODE_ENV=production
PORT=3000

# ─── REQUIRED ───────────────────────────────────────────────
# JWT session signing key (minimum 32 chars, use crypto-random)
JWT_SECRET=

# Production domain for CORS (e.g., https://concode.io)
ALLOWED_ORIGIN=

# Admin email for notifications and role assignment
ADMIN_ALERT_EMAIL=

# ─── AI PROVIDER (at least one required for chat) ──────────
# Google Gemini API key (https://aistudio.google.com/)
GEMINI_API_KEY=

# CONCODE Neural Brain endpoint (leave default if co-located)
NEURAL_BRAIN_URL=http://localhost:8000

# ─── DATABASE (choose one) ─────────────────────────────────
# Option A: MongoDB (recommended for production)
# MONGO_URI=mongodb://concode_admin:YOUR_PASSWORD@localhost:27017/concode?authSource=admin
# MONGO_PASSWORD=  # Required for Docker Compose

# Option B: Cloud Firestore
# USE_FIRESTORE=true
# GOOGLE_APPLICATION_CREDENTIALS=./config/firebase-service-account.json

# ─── OAUTH PROVIDERS ───────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# APPLE_CLIENT_ID=
# APPLE_CLIENT_SECRET=

# ─── PHONE OTP (Fast2SMS) ─────────────────────────────────
ENABLE_PHONE_AUTH=true
FAST2SMS_API_KEY=

# ─── EMAIL NOTIFICATIONS ──────────────────────────────────
# Option A: Resend API (recommended, no app password needed)
RESEND_API_KEY=

# Option B: SMTP / Gmail App Password
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=

# ─── OPTIONAL ──────────────────────────────────────────────
# Preview server port (set to 0 to disable in production)
# PREVIEW_PORT=3001

# Auto-training interval in milliseconds (default: 300000 = 5 min in production)
# BRAIN_TRAIN_INTERVAL_MS=300000

# Webhook integrations
# DISCORD_WEBHOOK_URL=
# SLACK_WEBHOOK_URL=
