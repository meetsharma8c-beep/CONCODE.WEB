# CONCODE Platform Environment Variables
PORT=3000

# Admin dashboard credentials
ADMIN_TOKEN=admin123

# Google Gemini API key (Required for AI assistant)
# Obtain a key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=

# Cloud Database configurations (Firestore)
# Toggle to true to connect to Google Cloud Firestore using config keys
USE_FIRESTORE=true

# OAuth Client Credentials (Google, GitHub, Apple)
# Optional slots for real OAuth integrations
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# Secret key for JWT sessions signature validation
JWT_SECRET=concode_super_secret_session_token_key

