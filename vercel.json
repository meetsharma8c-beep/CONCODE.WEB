{
  "version": 2,
  "alias": ["concode-sys.vercel.app"],
  "cleanUrls": true,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["public/**", "data/**", "utils/**", "config/**"]
      }

    }
  ],
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/api/(.*)",
      "dest": "server.js"
    },
    {
      "src": "/project/(.*)",
      "dest": "server.js"
    },
    {
      "src": "/projects/(.*)",
      "dest": "server.js"
    },
    {
      "src": "/(.*)",
      "dest": "server.js"
    }
  ]
}

